# Prevent Claude from reading its own session logs during codebase searches.
# These files contain past conversation transcripts and can cause hallucinations
# and token limit exhaustion if accidentally included in search results.

# Audit session logs (auto-generated by audit-hooks.mjs)
.claude/audit/sessions/

# Session plans (auto-generated by plan mode)
.claude/plans/

# Session results (auto-generated)
.claude/results/

# Build artifacts and dependencies (already in .gitignore but worth excluding from search)
node_modules/
.next/
dist/
build/
out/
coverage/
