// Prisma 7 Configuration
// This file handles environment loading and database configuration
// No need for dotenv-cli - environment is loaded here

import { config } from 'dotenv'
config({ path: '.env.local' })

import { defineConfig, env } from 'prisma/config'

export default defineConfig({
  // Schema location
  schema: 'prisma/schema.prisma',

  // Migrations configuration
  migrations: {
    path: 'prisma/migrations',
  },

  // Database connection for migrations (uses DIRECT_URL for direct connection)
  datasource: {
    url: env('DIRECT_URL'),
  },
})
