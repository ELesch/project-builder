{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-secrets.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(cat .env)",
      "Bash(type .env)",
      "Read(.env)"
    ]
  }
}
