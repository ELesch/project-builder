{
  "orchestrator": {
    "version": "{{ORCHESTRATOR_VERSION}}",
    "templateVersion": "{{TEMPLATE_VERSION}}"
  },
  "project": {
    "name": "{{PROJECT_NAME}}",
    "slug": "{{PROJECT_SLUG}}",
    "type": "{{PROJECT_TYPE}}",
    "primaryLanguage": "{{PRIMARY_LANGUAGE}}",
    "mobileApps": "{{MOBILE_APPS}}"
  },
  "created": {
    "date": "{{DATE}}",
    "method": "{{CREATION_METHOD}}"
  },
  "ai": {
    "trainingCutoff": "2025-05",
    "knownVersionsBaseline": "2025-05"
  },
  "techValidation": {
    "lastValidated": "{{DATE}}",
    "aiTrainingCutoffAtValidation": "2025-05",
    "validatedVersions": {
      {{VALIDATED_VERSIONS}}
    },
    "confidenceLevels": {
      {{CONFIDENCE_LEVELS}}
    }
  },
  "domainAgents": {
    "knowledgeFiles": {
      {{KNOWLEDGE_FILES}}
    },
    "generated": {
      {{DOMAIN_AGENTS_GENERATED}}
    },
    "registry": {
      "byTechnology": {
        {{DOMAIN_AGENTS_BY_TECHNOLOGY}}
      },
      "byRole": {
        {{DOMAIN_AGENTS_BY_ROLE}}
      },
      "supersessionMap": {
        {{DOMAIN_AGENTS_SUPERSESSION_MAP}}
      }
    },
    "sharedKnowledge": [{{SHARED_KNOWLEDGE_FILES}}],
    "templateSources": {
      {{DOMAIN_AGENTS_TEMPLATE_SOURCES}}
    }
  },
  "versionControl": {
    "provider": "{{VC_PROVIDER}}",
    "repository": "{{REPO_URL}}",
    "clonedFrom": {{CLONED_FROM}}
  },
  "services": {
    "database": "{{DATABASE}}",
    "hosting": "{{HOSTING}}",
    "errorTracking": "{{ERROR_TRACKING}}"
  },
  "logging": {
    "library": "{{LOGGING_LIBRARY}}",
    "errorTracking": "{{ERROR_TRACKING}}",
    "aggregation": "{{LOG_AGGREGATION}}"
  },
  "mcp": {
    "servers": ["context7"],
    "context7": {
      "enabled": true,
      "purpose": "Live documentation lookup"
    }
  },
  "migration": {
    "migratedFrom": {{MIGRATED_FROM}},
    "originalPath": {{ORIGINAL_PATH}},
    "preMigrationBackup": {{PRE_MIGRATION_BACKUP}}
  },
  "audit": {
    "enabled": true,
    "sessionsDir": ".claude/audit/sessions",
    "decisionsDir": ".claude/audit/decisions"
  }
}
