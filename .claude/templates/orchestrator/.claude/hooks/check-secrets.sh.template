#!/bin/bash
# Credentials Security Hook
# Prevents Claude from committing secrets

# Read hook data from stdin (Claude Code passes JSON)
INPUT=$(cat)

# Block git add of .env files
if echo "$INPUT" | grep -q "git add" && echo "$INPUT" | grep -qE '\.env[^.]|\.env$'; then
  echo "BLOCKED: Cannot stage .env files. Secrets must never be committed." >&2
  echo "Use .env.example for documenting required variables." >&2
  exit 1
fi

# Block commits if .env is staged
if echo "$INPUT" | grep -q "git commit"; then
  if git diff --cached --name-only 2>/dev/null | grep -qE '^\.env$|^\.env\.'; then
    echo "BLOCKED: .env file is staged. Remove with: git reset HEAD .env" >&2
    exit 1
  fi

  # Check for hardcoded secrets in staged files
  PATTERNS='(api[_-]?key|secret[_-]?key|password|private[_-]?key)\s*[:=]\s*["\x27][A-Za-z0-9+/=_-]{16,}["\x27]'
  if git diff --cached 2>/dev/null | grep -iE "$PATTERNS"; then
    echo "BLOCKED: Possible hardcoded secret detected in staged changes." >&2
    echo "Move secrets to .env and use process.env instead." >&2
    exit 1
  fi
fi

exit 0
