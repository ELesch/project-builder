#!/bin/bash
# Credentials Security Hook
# Prevents Claude from committing secrets and writing secrets via Edit/Write tools

# Read hook data from stdin (Claude Code passes JSON)
INPUT=$(cat)

# --- Edit/Write payload scanning ---
# Extract tool name from Claude Code hook input (uses Node.js, a required dependency)
TOOL_NAME=$(echo "$INPUT" | node -e "
  let d=''; process.stdin.on('data',c=>d+=c);
  process.stdin.on('end',()=>{try{console.log(JSON.parse(d).tool_name||'')}catch{console.log('')}});
" 2>/dev/null)

# For Edit/Write tools, scan the payload for secrets before they reach the filesystem
if [ "$TOOL_NAME" = "Edit" ] || [ "$TOOL_NAME" = "Write" ]; then
  CONTENT=$(echo "$INPUT" | node -e "
    let d=''; process.stdin.on('data',c=>d+=c);
    process.stdin.on('end',()=>{
      try{
        const j=JSON.parse(d);
        console.log(j.tool_input?.new_string || j.tool_input?.content || '');
      }catch{console.log('')}
    });
  " 2>/dev/null)

  # Check for key=value secret patterns
  PATTERNS='(api[_-]?key|secret[_-]?key|password|private[_-]?key|auth[_-]?secret|jwt[_-]?secret)\s*[:=]\s*["'"'"'][A-Za-z0-9+/=_-]{16,}["'"'"']'
  if echo "$CONTENT" | grep -iEq "$PATTERNS"; then
    echo "BLOCKED: Possible hardcoded secret detected in $TOOL_NAME payload." >&2
    echo "Move secrets to .env and reference via process.env." >&2
    exit 1
  fi

  # Check for common secret prefixes (AWS, Supabase, Stripe, GitHub, Slack, etc.)
  PREFIXES='(AKIA[0-9A-Z]{16}|sk_live_|sk_test_|eyJhbG|ghp_[A-Za-z0-9]{36}|xoxb-)'
  if echo "$CONTENT" | grep -Eq "$PREFIXES"; then
    echo "BLOCKED: Known secret prefix detected in $TOOL_NAME payload." >&2
    exit 1
  fi

  exit 0
fi

# --- Bash tool: git command scanning ---

# Block git add of .env files
if echo "$INPUT" | grep -q "git add" && echo "$INPUT" | grep -qE '\.env[^.]|\.env$'; then
  echo "BLOCKED: Cannot stage .env files. Secrets must never be committed." >&2
  echo "Use .env.example for documenting required variables." >&2
  exit 1
fi

# Block commits if .env is staged
if echo "$INPUT" | grep -q "git commit"; then
  if git diff --cached --name-only 2>/dev/null | grep -qE '^\.env$|^\.env\.'; then
    echo "BLOCKED: .env file is staged. Remove with: git reset HEAD .env" >&2
    exit 1
  fi

  # Check for hardcoded secrets in staged files
  PATTERNS='(api[_-]?key|secret[_-]?key|password|private[_-]?key)\s*[:=]\s*["\x27][A-Za-z0-9+/=_-]{16,}["\x27]'
  if git diff --cached 2>/dev/null | grep -iE "$PATTERNS"; then
    echo "BLOCKED: Possible hardcoded secret detected in staged changes." >&2
    echo "Move secrets to .env and use process.env instead." >&2
    exit 1
  fi
fi

exit 0
