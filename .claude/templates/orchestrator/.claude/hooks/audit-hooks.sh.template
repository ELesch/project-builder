#!/bin/bash
# Audit Trail Hooks
# Captures agent delegations, completions, and failures to session logs
#
# Claude Code passes JSON on stdin with these fields:
# - hook_event_name: SubagentStart, SubagentStop, PostToolUseFailure, etc.
# - session_id: Current session ID
# - transcript_path: Path to full transcript JSONL
# - agent_type: For subagent events
# - agent_id: For subagent events
# - tool_name: For tool events
# - error: For failure events

# Configuration
AUDIT_DIR=".claude/audit/sessions"
DATE=$(date +%Y-%m-%d)
LOG_FILE="$AUDIT_DIR/$DATE.md"
TIMESTAMP=$(date +%H:%M:%S)
FULL_TIMESTAMP=$(date -Iseconds)

# Ensure audit directory exists
mkdir -p "$AUDIT_DIR"

# Initialize log file if it doesn't exist
if [ ! -f "$LOG_FILE" ]; then
    cat > "$LOG_FILE" << EOF
# Session Log: $DATE

> Auto-generated by audit-hooks.sh

EOF
fi

# Read JSON from stdin (this is how Claude Code passes data to hooks)
INPUT=$(cat)

# Check if jq is available
if ! command -v jq &> /dev/null; then
    echo "### $TIMESTAMP - Hook Error: jq not installed" >> "$LOG_FILE"
    exit 0
fi

# Extract common fields from JSON
EVENT_TYPE=$(echo "$INPUT" | jq -r '.hook_event_name // "unknown"')
SESSION_ID=$(echo "$INPUT" | jq -r '.session_id // "unknown"')

# Parse based on event type
case "$EVENT_TYPE" in
    "SubagentStart")
        AGENT_TYPE=$(echo "$INPUT" | jq -r '.agent_type // "unknown"')
        AGENT_ID=$(echo "$INPUT" | jq -r '.agent_id // "unknown"')

        cat >> "$LOG_FILE" << EOF

### $TIMESTAMP - Agent Delegated: $AGENT_TYPE

| Field | Value |
|-------|-------|
| Timestamp | $FULL_TIMESTAMP |
| Agent Type | $AGENT_TYPE |
| Agent ID | $AGENT_ID |
| Session | $SESSION_ID |
| Status | In Progress |

EOF
        ;;

    "SubagentStop")
        AGENT_TYPE=$(echo "$INPUT" | jq -r '.agent_type // "unknown"')
        AGENT_ID=$(echo "$INPUT" | jq -r '.agent_id // "unknown"')
        AGENT_TRANSCRIPT=$(echo "$INPUT" | jq -r '.agent_transcript_path // ""')

        cat >> "$LOG_FILE" << EOF

### $TIMESTAMP - Agent Completed: $AGENT_TYPE

| Field | Value |
|-------|-------|
| Timestamp | $FULL_TIMESTAMP |
| Agent Type | $AGENT_TYPE |
| Agent ID | $AGENT_ID |
| Transcript | $AGENT_TRANSCRIPT |
| Status | Completed |

EOF

        # Auto-run tests and write results for orchestrator verification
        VERIFY_FILE=".claude/results/last-agent-verify.md"
        mkdir -p .claude/results

        {
          echo "## Auto-Verification: $AGENT_TYPE ($AGENT_ID)"
          echo ""
          echo "**Completed:** $FULL_TIMESTAMP"
          echo ""

          # Detect test runner and run
          if [ -f "package.json" ]; then
            echo "### Test Results"
            echo '```'
            npm test --if-present 2>&1 | tail -20
            TEST_EXIT=${PIPESTATUS[0]}
            echo '```'
            echo ""
            if [ $TEST_EXIT -eq 0 ]; then
              echo "**Status: PASS**"
            else
              echo "**Status: FAIL** (exit code $TEST_EXIT)"
            fi
          else
            echo "**Status: SKIPPED** (no package.json found)"
          fi

          echo ""
          echo "### Build Check"
          if [ -f "package.json" ]; then
            echo '```'
            npm run build --if-present 2>&1 | tail -10
            BUILD_EXIT=${PIPESTATUS[0]}
            echo '```'
            if [ $BUILD_EXIT -eq 0 ]; then
              echo "**Build: PASS**"
            else
              echo "**Build: FAIL** (exit code $BUILD_EXIT)"
            fi
          fi
        } > "$VERIFY_FILE" 2>&1 &
        ;;

    "PostToolUseFailure")
        TOOL_NAME=$(echo "$INPUT" | jq -r '.tool_name // "unknown"')
        ERROR_MSG=$(echo "$INPUT" | jq -r '.error // "unknown error"' | head -c 500 | tr '\n' ' ')

        cat >> "$LOG_FILE" << EOF

### $TIMESTAMP - Tool Failed: $TOOL_NAME

| Field | Value |
|-------|-------|
| Timestamp | $FULL_TIMESTAMP |
| Tool | $TOOL_NAME |
| Error | $ERROR_MSG |
| Session | $SESSION_ID |

EOF
        ;;

    "SessionStart")
        SOURCE=$(echo "$INPUT" | jq -r '.source // "unknown"')
        MODEL=$(echo "$INPUT" | jq -r '.model // "unknown"')

        cat >> "$LOG_FILE" << EOF

---

## Session Started: $FULL_TIMESTAMP

| Field | Value |
|-------|-------|
| Source | $SOURCE |
| Model | $MODEL |
| Session ID | $SESSION_ID |

EOF
        ;;

    "SessionEnd")
        REASON=$(echo "$INPUT" | jq -r '.reason // "unknown"')

        cat >> "$LOG_FILE" << EOF

## Session Ended: $FULL_TIMESTAMP

| Field | Value |
|-------|-------|
| Reason | $REASON |
| Session ID | $SESSION_ID |

---

EOF
        ;;

    "unknown"|"")
        # No event type - might be old format or error
        echo "### $TIMESTAMP - Hook fired (no event type in input)" >> "$LOG_FILE"
        ;;

    *)
        # Log other events for debugging
        echo "### $TIMESTAMP - Event: $EVENT_TYPE (session: $SESSION_ID)" >> "$LOG_FILE"
        ;;
esac

# Always exit successfully - audit should never block operations
exit 0
