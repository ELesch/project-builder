#!/usr/bin/env node
// Credentials Security Hook (Node.js - cross-platform)
// Prevents Claude from committing secrets and writing secrets via Edit/Write tools
//
// Uses Node.js instead of bash for reliable Windows + macOS + Linux support.
// Node.js is a required dependency for all orchestrator projects.

const chunks = [];
process.stdin.on('data', chunk => chunks.push(chunk));
process.stdin.on('end', () => {
  try {
    const input = JSON.parse(Buffer.concat(chunks).toString());
    const toolName = input.tool_name || '';
    const toolInput = input.tool_input || {};

    // --- Edit/Write payload scanning ---
    if (toolName === 'Edit' || toolName === 'Write') {
      const targetFile = toolInput.file_path || toolInput.target || toolInput.absolute_path || '';

      // Bypass secret scanning for test and mock files
      if (/\.(test|spec)\.|\/mocks?\/|\/fixtures?\//i.test(targetFile)) {
        process.exit(0);
      }

      const content = toolInput.new_string || toolInput.content || '';

      // Check for key=value secret patterns
      const secretPattern = /(api[_-]?key|secret[_-]?key|password|private[_-]?key|auth[_-]?secret|jwt[_-]?secret)\s*[:=]\s*["'][A-Za-z0-9+/=_-]{16,}["']/i;
      if (secretPattern.test(content)) {
        process.stderr.write(`BLOCKED: Possible hardcoded secret detected in ${toolName} payload.\n`);
        process.stderr.write('Move secrets to .env and reference via process.env.\n');
        process.exit(1);
      }

      // Check for common secret prefixes (AWS, Supabase, Stripe, GitHub, Slack, etc.)
      const prefixPattern = /(AKIA[0-9A-Z]{16}|sk_live_|sk_test_|eyJhbG|ghp_[A-Za-z0-9]{36}|xoxb-)/;
      if (prefixPattern.test(content)) {
        process.stderr.write(`BLOCKED: Known secret prefix detected in ${toolName} payload.\n`);
        process.exit(1);
      }

      process.exit(0);
    }

    // --- Bash tool: git command scanning ---
    const command = toolInput.command || '';

    // Block git add of .env files
    if (command.includes('git add') && /\.env([^.]|$)/.test(command)) {
      process.stderr.write('BLOCKED: Cannot stage .env files. Secrets must never be committed.\n');
      process.stderr.write('Use .env.example for documenting required variables.\n');
      process.exit(1);
    }

    // Block commits if .env is staged (check via git)
    if (command.includes('git commit')) {
      const { execSync } = require('child_process');
      try {
        const staged = execSync('git diff --cached --name-only', { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] });
        if (/^\.env$|^\.env\./m.test(staged)) {
          process.stderr.write('BLOCKED: .env file is staged. Remove with: git reset HEAD .env\n');
          process.exit(1);
        }

        // Check for hardcoded secrets in staged changes
        const diff = execSync('git diff --cached', { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] });
        const stagedSecretPattern = /(api[_-]?key|secret[_-]?key|password|private[_-]?key)\s*[:=]\s*["'][A-Za-z0-9+/=_-]{16,}["']/i;
        if (stagedSecretPattern.test(diff)) {
          process.stderr.write('BLOCKED: Possible hardcoded secret detected in staged changes.\n');
          process.stderr.write('Move secrets to .env and use process.env instead.\n');
          process.exit(1);
        }
      } catch {
        // Git commands failed (not a git repo, etc.) - allow through
      }
    }

    process.exit(0);
  } catch {
    // If JSON parsing or anything else fails, allow through
    process.exit(0);
  }
});
